# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채운다. .env는 절대 커밋하지 않는다.

# GitHub: 이슈를 읽어 색인할 저장소와 읽기 권한이 있는 토큰
GITHUB_TOKEN=
GITHUB_OWNER=MCP-Capstone
GITHUB_REPO=mcp-capstone
# 선택: 값이 있으면 이 저장소들만 허용 (쉼표 구분 owner/repo). 비우면 검사하지 않음 (저장소는 Agent가 프로젝트 정보로 넘김)
GITHUB_ALLOWED_REPOS=

# 임베딩: OpenAI API 키와 모델
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB(Chroma)를 저장할 폴더. 비우면 rag-mcp/chroma-data
CHROMA_PATH=

# 선택: 서버 주소 (기본 127.0.0.1:8002)
MCP_HOST=
MCP_PORT=
