# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채운다. .env는 절대 커밋하지 않는다.

# GitHub: 서비스 계정 토큰 하나를 모든 프로젝트 저장소에 쓴다.
# 서비스 계정을 각 프로젝트 저장소에 초대하고, Issues 읽기·쓰기 권한을 준다.
GITHUB_TOKEN=
# 선택: 값이 있으면 이 저장소들만 허용 (쉼표 구분 owner/repo, 로컬 테스트용 안전장치).
# 비우면 검사하지 않는다. 저장소는 Agent가 백엔드 프로젝트 정보로 넘긴다.
GITHUB_ALLOWED_REPOS=

# Notion: 기획 문서 읽기와 '회의 후속 티켓' 하위 페이지 생성에 쓰는 Integration 토큰.
# 토큰만으로는 페이지에 접근할 수 없다. 테스트/운영 상위 페이지를 해당 Integration에 공유해야 한다.
NOTION_TOKEN=

# 선택: 서버 주소 (기본 127.0.0.1:8000)
MCP_HOST=
MCP_PORT=
