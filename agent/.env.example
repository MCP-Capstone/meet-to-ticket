# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채운다. .env는 절대 커밋하지 않는다.
OPENAI_API_KEY=
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# rag-mcp (기존 이슈 색인·검색, 중복 판단에 사용). false면 중복 확인 없이 발행
RAG_ENABLED=false
RAG_MCP_URL=http://127.0.0.1:8002/mcp
# 실행마다 색인 갱신(바뀐 이슈만)을 기다리는 시간, 모델에게 넘기는 도구 결과 길이 한도
RAG_SYNC_TIMEOUT_SECONDS=30
TOOL_RESULT_MAX_CHARS=2000
# 중복 판단: 모델이 조회 도구를 골라 기존 이슈와 같은지 판단 (RAG_ENABLED=true일 때)
OPENAI_DEDUPE_MODEL=gpt-5.4-mini
DEDUPE_MAX_TOOL_CALLS=4
DEDUPE_MAX_SAME_TOOL=3
DEDUPE_TIMEOUT_SECONDS=30
DEDUPE_CONCURRENCY=4

# 선택 (비워 두면 기본값)
# 추출·초안 모델 (기본 gpt-5.4-nano), 검수 모델 (기본 gpt-5.4-mini)
OPENAI_MODEL=
OPENAI_REVIEW_MODEL=
# 추론 강도 (예: none, low, medium, high — 모델이 받는 값)
# 추출·초안은 기본 none: 추론을 끄고 temperature 0으로 같은 회의록이면 같은 초안을 만든다
# 검수는 비우면 모델 기본 추론을 쓴다 (gpt-5 계열은 추론을 켜면 temperature가 1로 고정됨)
OPENAI_REASONING_EFFORT=
OPENAI_REVIEW_REASONING_EFFORT=
# 대체 모델: 429·5xx·타임아웃이 재시도 후에도 계속되면 이 모델로 한 번 더 호출 (비우면 끔, 예: gpt-4.1-mini)
OPENAI_FALLBACK_MODEL=
# LangSmith trace (true면 작업 1건이 trace 하나로 수집됨: 노드, LLM 호출, Token, 지연)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meet-to-ticket
# 백엔드 진행·결과 보고 (비우면 보고하지 않음)
BACKEND_BASE_URL=
BACKEND_INTERNAL_TOKEN=
# 이슈 라벨 후보 (쉼표 구분, 저장소에 있는 라벨). 초안 작성 때 이 중에서 티켓마다 0~3개를 고른다.
# 요청의 project.labels가 있으면 그 값을 쓰고 이 값은 쓰지 않는다
ISSUE_LABELS=
# true면 GitHub에 발행하지 않고 추출/검수만 실행 (기본 true). 실제로 이슈를 만들려면 false로 바꾼다.
# Docker Compose 실행에서는 루트 .env의 DRY_RUN이 이 값보다 우선한다.
DRY_RUN=true
# 조건부 기존 이슈 갱신을 확인 필요로 둘지
CONDITIONAL_AS_NEEDS_CHECK=true
MAX_REVISIONS=2
# 실행 한도 (0 이하면 마감·길이 한도를 끔)
LLM_TIMEOUT_SECONDS=120
TASK_DEADLINE_SECONDS=600
MAX_SOURCE_CHARS=40000
