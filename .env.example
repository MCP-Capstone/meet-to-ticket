# docker-compose.yml과 compose.full.yml에서 사용한다. 이 파일을 .env로 복사해서 수정한다.
# 로컬 DB·RabbitMQ 전용 구성과 bootRun(local 프로파일)은 기본값을 쓸 수 있다. 전체 구성은 공유 토큰 설정이 필요하다.
# demo/local/test 외의 프로파일로 backend를 실행하면 기본값 비밀번호와 빈 BACKEND_INTERNAL_TOKEN은 기동이 거부된다.
# 바꾸면 backend의 DB_USERNAME, DB_PASSWORD 환경 변수도 같은 값으로 맞춘다.
POSTGRES_DB=meettoticket
POSTGRES_USER=meettoticket
POSTGRES_PASSWORD=meettoticket

# compose.full.yml: Agent와 Spring이 공유하는 토큰. 빈 값이면 실행하지 않는다.
# openssl rand -hex 32 등으로 생성한 값을 입력한다.
BACKEND_INTERNAL_TOKEN=
# true: 추출·검수만 실행. false: 실제 GitHub Issue 발행.
DRY_RUN=true
# true: 발행 전 rag-mcp로 기존 이슈와 중복 판단. false: 중복 판단 없이 발행.
RAG_ENABLED=true
AGENT_MODE=live
FRONTEND_PORT=5173
BACKEND_PORT=8080
DEMO_LOGIN_ID=demo1
DEMO_PASSWORD=password1

# RabbitMQ: 로컬 개발 주소. 전체 Compose는 host를 rabbitmq, port를 5672로 지정한다.
# 사용자·비밀번호·vhost는 RabbitMQ와 backend에 같은 값을 설정한다.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=meettoticket
RABBITMQ_PASSWORD=meettoticket
RABBITMQ_VHOST=/

# 멈춘 Agent 접수의 조회 복구 기한과 DLQ 실패 기록 복구 주기
ANALYSIS_SUBMITTING_TIMEOUT=2m
ANALYSIS_FAILURE_RECONCILE_INTERVAL_MS=5000
